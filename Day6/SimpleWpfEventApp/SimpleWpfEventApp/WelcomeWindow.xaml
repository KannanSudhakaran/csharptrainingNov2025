<Window x:Class="SimpleWpfEventApp.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleWpfEventApp"
        mc:Ignorable="d"
        Background="Azure"
        Title="WelcomeWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Click me!"
                Width="100"
                Name="btnClickMe"
                Height="50"
                HorizontalAlignment="Left"
                Margin="363,100,0,0" 
                VerticalAlignment="Top"/>
        <Button Content="Close" 
                Width="100"
                Height="50"
                Name="btnClose"
                
                HorizontalAlignment="Left" Margin="503,100,0,0" VerticalAlignment="Top" Click="btnClose_Click"/>
        <Button Content="NewWindow"
                Width="100"
                Height="50"
                HorizontalAlignment="Left" 
                Margin="638,100,0,0" VerticalAlignment="Top" Click="Button_Click"/>
    </Grid>
</Window>
